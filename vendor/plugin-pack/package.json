{
	"name": "@openclime/plugin-pack",
	"version": "0.2.0",
	"description": "Pack an openclime plugin directory into a marketplace-ready zip — the reusable CLI behind scripts/pack-plugin.mjs. Third-party plugin repos `npx openclime-plugin-pack . --out dist` in their release workflow.",
	"keywords": [
		"cli",
		"openclime",
		"pack",
		"plugin",
		"zip"
	],
	"license": "MIT",
	"author": "OpenClime",
	"repository": {
		"type": "git",
		"url": "https://github.com/bingryan/openclime",
		"directory": "packages/plugin-pack"
	},
	"bin": {
		"openclime-plugin-pack": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist",
		"prepublishOnly": "pnpm clean && pnpm build",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@openclime/plugin-manifest": "file:../plugin-manifest",
		"fflate": "^0.8.2"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
